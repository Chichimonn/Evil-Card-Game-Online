# Online play relay (TURN) server, for players whose networks can't connect directly (see src/net/connection.ts).
# Optional, but without it some pairs of players can't connect at all. Set these in your host's environment
# variables (e.g. Vercel: Project Settings > Environment Variables), then redeploy.
VITE_TURN_URLS="turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:80?transport=tcp,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp"
VITE_TURN_USERNAME="MY_TURN_USERNAME"
VITE_TURN_CREDENTIAL="MY_TURN_CREDENTIAL"
